# Database configuration
DATABASE_URL=postgresql+psycopg://pakinggan:development@localhost:5432/pakinggan
TEST_DATABASE_URL=postgresql+psycopg://pakinggan:development@localhost:5432/pakinggan_test

# JWT authentication
JWT_SECRET_KEY=replace_with_a_generated_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Last.fm API configuration
LASTFM_API_KEY=your_api_key
LASTFM_SHARED_SECRET=your_shared_secret
LASTFM_ENCRYPTION_KEY=your_generated_key